# Maxey0-SuperSpace deployment configuration.
#
# Copy to `.env` (gitignored) and fill in. `maxey0_ss.settings.load_env_file`
# reads it at import, so a host that spawns a stdio server -- which cannot
# export anything first -- still gets the configuration.
#
# NEVER COMMIT REAL VALUES. `scripts/_packaging.py` refuses to put `.env`,
# `.env.local`, `.env.production` or `config/credentials.json` into any archive,
# and both builders scan the bytes of every file they are about to zip for
# credential shapes and fail the build on a hit. `.env.example` is the one
# `.env*` file that ships, because it is this list.
#
# Every variable below is read by this build. `tests/test_configuration.py`
# asserts that in both directions: a variable the code reads and this file does
# not declare fails, and a variable declared here that nothing reads fails too.
# A settings file that documents keys the code ignores is how you end up
# believing you configured something.
#
# Three markers:
#   [WIRED]  consumed by this build. Setting it changes behavior.
#   [SOCKET] recorded and reported, no provider implemented. Setting one raises
#            ConfiguredButUnimplemented and appears under `inert` in
#            `maxey0-ss.deployment`, rather than quietly doing nothing.
#   [EDGE]   consumed by the Cloudflare Worker in workers/mcp-edge, not by
#            Python. Set with `wrangler secret put` or in wrangler.jsonc.
#
# Credentials ship as <API_KEY> and <BEARER_TOKEN>: replace each with your own
# value, or delete the value to leave that feature unconfigured. A placeholder
# left in place is REFUSED -- a provider raises PlaceholderCredential, and a
# bearer token or A2A secret still set to <BEARER_TOKEN> is rejected rather
# than accepted as a password anyone could send.
#
# Other placeholder convention: REPLACE_ME, sk-ant-PLACEHOLDER,
# https://issuer.example.invalid. Deliberately unmistakable. Nothing here is a
# plausible-looking fake that could be taken for a live value.

# =========================================================== [WIRED] =========
# --- Process -----------------------------------------------------------------
MAXEY0_HOST=127.0.0.1
MAXEY0_PORT=8765
MAXEY0_ENV=development

# --- Authorization -----------------------------------------------------------
# See docs/AUTHORIZATION.md.
#   disabled  trusted local. Every caller is admin (see MAXEY0_PUBLIC).
#   bearer    Authorization: Bearer <token>, matched against the tokens below.
#   oidc      Authorization: Bearer <JWT>, verified against the OIDC block
#             below. Misconfigured, it refuses with -32004/501 and names the
#             missing variable; it never falls back to bearer or disabled.
# Case and surrounding spaces are ignored. ANY OTHER VALUE refuses every
# request with -32004/501. It used to be read as `disabled`, so a misspelt
# `bearer` without MAXEY0_PUBLIC=1 made every caller admin.
MAXEY0_AUTH_MODE=disabled

# Set to 1 on ANY internet-reachable deployment.
#
# What breaks without it: with MAXEY0_AUTH_MODE=disabled, every caller resolves
# to the admin role. The edge adapter performs no authorization by design and
# forwards `authorization` verbatim, so an unset MAXEY0_PUBLIC on a reachable
# origin is unauthenticated admin over the internet. `maxey0-ss.auth.manifest`
# reports `admin_open: true` when you are in this state, with a warning.
MAXEY0_PUBLIC=

# Per-caller tokens, stored as SHA-256 digests rather than as the tokens, so a
# leaked copy of this file is not a working credential. Comma separated:
#   sha256:<64 lowercase hex>:<role>:<label>
# Roles: viewer, operator, builder, admin. The label (1-64 of A-Z a-z 0-9 . _ -)
# is how the caller appears in logs, as `bearer:<label>`; `auth.manifest`
# reports only how many entries there are, never a label or a digest.
#   python scripts/mint_token.py --role operator --label ci-runner
# mints a token, prints it once, and prints the entry to paste here. Add
# `--from-file PATH` to hash a token you already issued instead.
# A malformed entry, an unknown role, or a repeated label or digest refuses
# EVERY bearer request with -32004/501, naming this variable and the entry
# number. The bad entry is not skipped.
MAXEY0_MCP_TOKEN_HASHES=

# Plaintext token:role pairs, comma separated. Still accepted so an existing
# deployment keeps working, and held to the same rules: an unknown role or a
# repeated token refuses every request with -32004/501. A token here that is
# also in MAXEY0_MCP_TOKEN_HASHES is a repeat -- remove the plaintext copy when
# you add the digest. With MAXEY0_PUBLIC=1, `auth.manifest` warns while any
# plaintext token (this one or the default below) is configured.
# What breaks without either: MAXEY0_AUTH_MODE=bearer refuses every request
# with -32001, because no token maps to a role.
MAXEY0_MCP_TOKENS=

# A single shared token, mapped to `operator` and never to `admin` -- one
# shared secret must not be able to turn the gate off. Plaintext, and counted
# as such by `auth.manifest`; appears in logs as `bearer:default`. Also
# readable from config/credentials.json as `mcp.default_bearer_token`.
MAXEY0_MCP_DEFAULT_BEARER_TOKEN=<BEARER_TOKEN>

# A2A shared secret, verified in constant time on /v1/a2a/message.
# What breaks without it: the A2A surface is UNSECURED. `a2a.secured` in
# `maxey0-ss.deployment` reports which state you are in. Also readable from
# config/credentials.json as `a2a.shared_secret`.
MAXEY0_A2A_SHARED_SECRET=<BEARER_TOKEN>

# --- Rate limiting and request caps ------------------------------------------
# Enforced at the origin by maxey0_ss.ratelimit, in front of /mcp, /mcp/session,
# /v1 and /health. Per process and in memory: counts reset on restart, and a
# second worker or Machine would multiply every limit. `maxey0-ss.auth.manifest`
# reports the settings, what was applied, and counts -- never an address, key
# or caller. Every variable below: empty means the default shown. A value that
# does not parse, or is zero or negative, also means the default, and is named
# under `rate_limit.invalid_settings` in the manifest.
#
# The switch for everything in this block, the session caps included.
# Empty means automatic: ON when MAXEY0_PUBLIC is set or MAXEY0_AUTH_MODE is
# anything but disabled, OFF for the trusted-local default. 1/true/on/yes forces
# it on, 0/false/off/no forces it off. Forced off with MAXEY0_PUBLIC=1, the
# manifest carries a warning. Refusals are HTTP 429 with Retry-After, and on
# /mcp and /mcp/session JSON-RPC error -32005 naming which limit was hit.
MAXEY0_RATE_LIMIT_ENABLED=

# Requests per minute from one client address (an IPv6 client is its /64).
# Default 120. Every request counts, /health included.
MAXEY0_RATE_LIMIT_IP_PER_MIN=
# Requests per minute for one authenticated caller (role + subject), from
# however many addresses it uses. Default 300.
MAXEY0_RATE_LIMIT_PRINCIPAL_PER_MIN=
# New /mcp/session sessions per minute from one client address. Default 6.
MAXEY0_RATE_LIMIT_SESSION_OPEN_PER_MIN=
# Wrong credentials per hour from one client address before that address gets
# 429 on EVERYTHING, valid token or not, until the budget refills. A request
# with no Authorization header never counts. Default 20.
MAXEY0_RATE_LIMIT_AUTH_FAILURES_PER_HOUR=
# Most client keys each limit tracks. Past it the least recently seen is
# forgotten, which bounds memory however many addresses call. Default 10000.
MAXEY0_RATE_LIMIT_MAX_KEYS=

# Comma-separated addresses or CIDRs of the peers allowed to name the client in
# CF-Connecting-IP. Default 127.0.0.1,::1 -- cloudflared, which connects from
# loopback both on the laptop and in the Fly Machine. From any other peer the
# header is ignored and the peer itself is the client, so a caller cannot pick
# a fresh address per request. One bad entry means the default, not a shorter
# list: an empty list would put every tunnel request in one bucket.
MAXEY0_TRUSTED_PROXY_IPS=

# Largest request body accepted, in bytes. Larger gets 413 before the body is
# parsed. Default 1048576 (1 MiB). Also passed to the /mcp/session transport,
# whose own default is 4 MiB.
MAXEY0_MAX_REQUEST_BYTES=
# Most concurrent /mcp/session sessions; past it a new one gets 503 and open
# ones are unaffected. Default 50 (the SDK's own is 10000).
MAXEY0_SESSION_MAX=
# Seconds a session may sit with no request in flight before it is closed and
# its id answers 404. Default 600 (the SDK's own is 1800).
MAXEY0_SESSION_IDLE_TIMEOUT_S=

# --- Model and dataset providers ---------------------------------------------
# Three providers ship and all three are callable. Every call through them is
# admitted by the semantic gate and written to the hash-chained attestation log
# before a byte leaves the process, with the prompt digested rather than stored.
# `maxey0-ss.deployment` reports which are configured.
#
# A PLACEHOLDER VALUE IS REFUSED, LOUDLY. Leaving REPLACE_ME in place below does
# not mean "unconfigured" -- it means "configured with a template", which passes
# every truthiness check and then fails at the vendor with an error that sends
# you looking in the wrong system. The provider raises PlaceholderCredential
# instead and names the variable. Empty is the correct way to say "not set".

# Anthropic Messages API. Also readable from config/credentials.json.
# What breaks without it: maxey0-ss.provider.complete with provider=anthropic
# raises NotConfigured. Nothing else is affected.
ANTHROPIC_API_KEY=<API_KEY>
MAXEY0_ANTHROPIC_MODEL=

# OpenAI Responses API, and Chat Completions for OpenAI-compatible endpoints.
OPENAI_API_KEY=<API_KEY>
MAXEY0_OPENAI_MODEL=
# Point at any OpenAI-compatible endpoint -- vLLM, Together, Groq, Azure, a
# local server. This changes WHO RECEIVES THE PROMPT, so `maxey0-ss.deployment`
# reports `endpoint_is_default: false` when it is set.
OPENAI_BASE_URL=
OPENAI_ORG_ID=

# Hugging Face. The Hub half (dataset and model metadata) needs no credential,
# deliberately: the published incident demonstration must be reproducible by a
# reader without an account. The inference half does need one.
HF_TOKEN=<API_KEY>
# Read as aliases so a machine already set up for the Hugging Face CLI or an
# older SDK works without being reconfigured. HF_TOKEN wins.
HUGGINGFACE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
MAXEY0_HF_MODEL=

# Default model when a caller names no provider-specific one.
MAXEY0_MODEL=


# --- Containment -------------------------------------------------------------
# Which enforcement engine runs. `structural` is the default and the only one
# this build implements. Any other value names a provider that must be supplied
# and is REFUSED at startup rather than silently downgraded -- a containment
# claim that quietly falls back is not a claim.
MAXEY0_CONTAINMENT_PROVIDER=structural

# --- Host-local planes on a public deployment --------------------------------
# The maxey0-ss.observe.* tools (all but observe.studio) and gate.set_mode,
# gate.set_policy and gate.declare_isolation answer from files on the machine
# the origin runs on: the Context plane ledger (SCW_EVENT_LOG, else
# ~/.scw/events.jsonl), the Gate journal (~/.scw/gate.jsonl) and the Gate policy
# files under ~/.scw/gate that a local gate hook enforces from.
#
# With MAXEY0_PUBLIC=1 and this unset, they stay listed but touch none of it:
# reads return `available: false` naming this variable, and gate.set_mode and
# gate.set_policy refuse with `ok: false` and write nothing.
#
# Set to 1 (or true/yes/on) only if this origin should serve THIS MACHINE's
# journals -- recent agent tool calls per role, ledger records, absolute local
# paths -- to every caller holding `observe` (viewer and up, including the
# operator role the shared default bearer token maps to), and let an admin
# token rewrite the gate policy local sessions enforce. No effect without
# MAXEY0_PUBLIC: a local deployment always serves them.
MAXEY0_PUBLIC_HOST_PLANES=

# --- Cache -------------------------------------------------------------------
# See docs/CACHING.md. Reported by `maxey0-ss.cache.status`, which
# derives its policy block from these rather than restating constants.
MAXEY0_CACHE_ENABLED=
# Disables every read and write at once. A first-class control, not a debugging
# hack: a verification run must be able to prove a result was computed rather
# than replayed. Bypasses are counted and reported.
MAXEY0_CACHE_BYPASS=
MAXEY0_CACHE_MAX_ENTRIES=

# Per-plane TTLs in milliseconds. Protocol metadata changes only on redeploy;
# the SCW-bound planes are deliberately shorter, because a stale answer about
# live application state is worse than a slow one. A value of 0 means "do not
# cache this plane", not "cache forever".
MAXEY0_CACHE_TTL_MS_PROTOCOL=
MAXEY0_CACHE_TTL_MS_CONTEXT=
MAXEY0_CACHE_TTL_MS_EXECUTION=
MAXEY0_CACHE_TTL_MS_OBSERVATION=
MAXEY0_CACHE_TTL_MS_MODEL=

# --- Plugin runtime ----------------------------------------------------------
# Set by each generated plugin's own plugin.json, pointing inside its installed
# copy. Declared here because a bare `python server/context_server.py` run from
# the repository needs them too.
# What breaks without them: the vendored runtime and the loop library are not
# found, and the plane servers fail to start.
MAXEY0_ROOT=
MAXEY0_LOOPS=

# --- OIDC --------------------------------------------------------- [WIRED] --
# MAXEY0_AUTH_MODE=oidc verifies a bearer JWT against these three. Also readable
# from config/credentials.json's `oauth` section.
#
# Every trust decision comes from HERE, never from the token. An attacker
# chooses `iss`, so a verifier that fetched keys from the issuer the token names
# would verify tokens minted by anybody. The issuer, the audience and the key
# set are all configuration: a token naming another issuer is refused before a
# signature is computed, and one minted for another audience is refused however
# valid its signature. This is the resource-server analogue of RFC 9207's
# issuer binding; RFC 9207 itself is the client checking `iss` in an
# authorization response, which a resource server never sees.
#
# The key set is cached for 5 minutes. A token naming a key id the cache does
# not hold refreshes it -- that is what a key rotation looks like -- but at most
# once every 30 s, because anybody can send a made-up key id. If a refresh
# fails, the last good key set keeps verifying for up to 24 h, so an identity
# provider outage is not an authorization outage.
#
# What breaks without them: MAXEY0_AUTH_MODE=oidc refuses every request with
# -32004/501 and names the missing variable. It does NOT fall back to bearer or
# to disabled -- a deployment that asked for OIDC and silently got a shared
# secret would believe it had identity-provider-backed authorization.
MAXEY0_JWT_ISSUER=
MAXEY0_JWT_AUDIENCE=
MAXEY0_JWKS_URL=

# Which claim carries the caller's role: `roles`, `groups`, `realm_access.roles`,
# or a namespaced custom claim such as https://example.invalid/roles. Matched as
# an exact claim name first, then as a dotted path into nested claims. Providers
# disagree about where a role lives, so this is configured rather than guessed
# -- a verifier that guesses picks the wrong claim silently and grants the
# wrong access. A list resolves to the most privileged role in it that this
# build knows (admin, builder, operator, viewer), whatever order the provider
# lists them in; names it does not know are ignored. Unset, or naming no known
# role, means `viewer`: the least-privilege default rather than a convenience.
# Also readable from config/credentials.json as `oauth.role_claim`. Listed under
# `inert` unless MAXEY0_AUTH_MODE=oidc.
MAXEY0_OIDC_ROLE_CLAIM=

# =========================================================== [SOCKET] ========
# Credentials here are recorded and reported. No provider consumes them in this
# build, and `maxey0-ss.deployment` lists each one under `inert` so a deployer
# can see the gap between `configured` and `implemented`.

# The OAuth client half. This build verifies tokens it is handed rather than
# obtaining them, so nothing consumes these yet.
MAXEY0_OAUTH_CLIENT_ID=
MAXEY0_OAUTH_CLIENT_SECRET=

# Storage and graph backends. `storage` section of config/credentials.json.
MAXEY0_STORAGE_URL=
MAXEY0_NEO4J_URI=
MAXEY0_NEO4J_USERNAME=
MAXEY0_NEO4J_PASSWORD=

# Shared cache across instances. The in-process cache needs no configuration.
MAXEY0_REDIS_URL=

# Vector store for semantic retrieval. `SkillRecord.embedding` is ranked by
# `ExecutionRouter` in-process today; this is where a persistent store lands.
MAXEY0_VECTOR_STORE_URL=

# Semantic gate. The public build ships DisabledSemanticGate: structural SCW
# address validation only.
#
# IMPORTANT, and the reason this is not just another socket: naming a provider
# this build does not implement makes the gate FAIL CLOSED. Every SCW-bound
# tool call is refused with a reason naming the provider. That is deliberate --
# a deployment asking for stricter gating must never be answered with less.
# Set `disabled` (or leave empty) to accept structural validation only.
MAXEY0_SEMANTIC_GATE_PROVIDER=disabled
MAXEY0_SEMANTIC_GATE_ENDPOINT=
MAXEY0_SEMANTIC_GATE_API_KEY=

# Trace export. No exporter is implemented; setting it warns.
MAXEY0_TRACE_ENDPOINT=

# ============================================================ [EDGE] =========
# Read by workers/mcp-edge only. Set with `wrangler secret put <NAME>` or as a
# var in wrangler.jsonc -- putting them in this file has no effect on the Worker.

# Base URL of the Python origin, e.g. https://origin.example.invalid.
# What breaks without it: the edge serves MCP metadata and refuses every
# tools/call with -32010 and no `result` field. That is the designed
# metadata-only mode, not a failure -- but it is not a working deployment.
MAXEY0_ORIGIN=

# Seconds the edge may cache catalog responses. "0" means do not cache, and is
# honoured as such. Unset or unparseable falls back to 300.
MAXEY0_CATALOG_TTL=

# Comma-separated browser origins allowed to call /mcp, e.g.
# https://app.example.invalid,https://studio.example.invalid
#
# What changes when you set it: the edge echoes a matching Origin, sets
# `Vary: Origin`, and advertises `authorization` in
# `access-control-allow-headers`. Left unset, the edge answers `*` and does NOT
# advertise `authorization` -- any caller may read the public catalog, and no
# browser is told it may attach credentials to it. CORS binds browsers only;
# ordinary MCP clients are unaffected either way.
MAXEY0_ALLOWED_ORIGINS=
